# Frontend (Vite) — only VITE_* keys are embedded into the client build.
# NEVER put API keys or secrets here. AI/OAuth secrets belong in backend/.env.

# Absolute origin of the deployed backend, e.g. https://pixelcraft-api.onrender.com
# Leave EMPTY in local development: requests stay relative (/api) and are
# handled by the Vite dev proxy configured in vite.config.ts.
# In production, set this unless you add an explicit /api rewrite on the host.
VITE_API_BASE_URL=

# Local development only — backend target used by the Vite /api proxy.
# Not exposed to the browser bundle (no VITE_ prefix).
BACKEND_PROXY_TARGET=http://localhost:3001
