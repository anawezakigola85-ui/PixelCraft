# Pixelcraft backend keys — never used by the frontend directly.
# Copy to backend/.env and fill in what you need.

# --- Server ---
BACKEND_PORT=3001
# HOST=0.0.0.0

# --- AI (optional) ---
# Free tier: https://aistudio.google.com/api-keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Origins / OAuth ---
# Use the DEPLOYED frontend origin, no trailing slash.
# Local example: http://localhost:5173
APP_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
# Defaults to APP_URL/auth/callback when omitted:
# OAUTH_REDIRECT_URI=https://your-frontend.vercel.app/auth/callback
# Set to cross-origin when the frontend calls an absolute backend URL
# (VITE_API_BASE_URL). Keep same-origin for a same-origin /api rewrite.
CROSS_ORIGIN_RESOURCE_POLICY=cross-origin

# Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-frontend.vercel.app/auth/callback
GOOGLE_CLIENT_ID=
# Optional for confidential web clients (PKCE works without it for desktop/SPA):
GOOGLE_CLIENT_SECRET=

# Microsoft: https://portal.azure.com -> App registrations -> Authentication
# Redirect URI (Web): https://your-frontend.vercel.app/auth/callback
MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# Apple: https://developer.apple.com/account/resources/identifiers
# Return URL: https://your-frontend.vercel.app/auth/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 private key here (\n works), or point to the file:
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_FILE=/absolute/path/AuthKey_XXXXXXXXXX.p8
